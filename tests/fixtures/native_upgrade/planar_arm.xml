<mujoco model="native_upgrade_planar_arm">
  <compiler angle="radian"/>
  <option timestep="0.004" gravity="0 0 0" integrator="RK4"/>
  <default>
    <joint armature="0.02" damping="0.05"/>
    <geom contype="0" conaffinity="0" density="350"/>
  </default>
  <worldbody>
    <body name="upper_arm" pos="0 0 0">
      <joint name="shoulder" type="hinge" axis="0 0 1"/>
      <geom name="upper_link" type="capsule" fromto="0 0 0 0.5 0 0" size="0.035"/>
      <body name="forearm" pos="0.5 0 0">
        <joint name="elbow" type="hinge" axis="0 0 1"/>
        <geom name="forearm_link" type="capsule" fromto="0 0 0 0.4 0 0" size="0.03"/>
        <site name="tip" pos="0.4 0 0" size="0.01"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="shoulder_drive" joint="shoulder" gear="1" ctrllimited="true" ctrlrange="-1 1"/>
    <motor name="elbow_drive" joint="elbow" gear="0.7" ctrllimited="true" ctrlrange="-1 1"/>
  </actuator>
  <sensor>
    <jointpos name="shoulder_position" joint="shoulder"/>
    <jointpos name="elbow_position" joint="elbow"/>
  </sensor>
</mujoco>
